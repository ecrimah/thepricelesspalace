# ── App ──────────────────────────────────────────────
APP_NAME="New Project"
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Plain Postgres cutover trio (set together) ───────
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/store_palace
NEXT_PUBLIC_USE_PLAIN_PG=true
# App origin for browser http-client (NOT *.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
# PG_POOL_MAX=10
# PGSSL=require
# Legacy gate used by some admin routes (any non-empty string is fine on plain PG)
# SUPABASE_SERVICE_ROLE_KEY=local-service-role
# SUPABASE_JWT_SECRET=  # fallback for AUTH_JWT_SECRET

# ── Auth (must match tokens issued by /auth/v1) ─────
AUTH_JWT_SECRET=
# JWT_SECRET=   # fallback alias

# ── Disk storage (Shape A storage shim) ──────────────
STORAGE_ROOT=./uploads
STORAGE_PUBLIC_URL=http://localhost:3001
# STORAGE_SIGNING_SECRET=

# ── Admin bootstrap (scripts/create-admin.mjs) ───────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Contact / notifications ──────────────────────────
CONTACT_PHONE=+1 000 000 0000
EMAIL_FROM="New Project <noreply@example.com>"
RESEND_API_KEY=
SMS_SENDER_ID=NEWPROJ

# ── Payments (optional) ──────────────────────────────
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_API_KEY=
MOOLRE_SMS_API_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_CALLBACK_SECRET=
MOOLRE_MERCHANT_EMAIL=
MOOLRE_BASE_URL=https://api.moolre.com
PAYSTACK_SECRET_KEY=

# ── Security / bots ──────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
CRON_SECRET=

# ── Analytics / SEO (optional) ───────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── AI chat (optional) ───────────────────────────────
GROQ_API_KEY=
